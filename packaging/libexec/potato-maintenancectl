#!/usr/bin/python3
"""Switch Potato Agent between Interface and same-port maintenance service."""

from __future__ import annotations

import argparse
import configparser
import fcntl
import http.client
import ipaddress
import os
from pathlib import Path
import socket
import stat
import subprocess
import sys
import time


INTERFACE_UNIT = "potato-interface.service"
MAINTENANCE_UNIT = "potato-maintenance.service"
CONFIG_PATH = Path("/etc/potato-maintenance.conf")
LOCK_DIR = Path("/run/lock/potato-agent")
LOCK_PATH = LOCK_DIR / "maintenance.lock"
SYSTEMCTL = "/usr/bin/systemctl"
WAIT_ATTEMPTS = 40
WAIT_INTERVAL = 0.25


class ControlError(RuntimeError):
    pass


def _load_address(path: Path) -> tuple[str, int]:
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        raise ControlError("maintenance config must be a root-owned regular file")
    if stat.S_IMODE(info.st_mode) & 0o022:
        raise ControlError("maintenance config must not be writable by group or other")
    if info.st_size > 16 * 1024:
        raise ControlError("maintenance config is too large")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        raw = os.read(fd, 16 * 1024 + 1)
    finally:
        os.close(fd)
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read_string(raw.decode("ascii"))
        host = parser.get("server", "bind_host").strip()
        port = parser.getint("server", "bind_port")
        address = ipaddress.ip_address(host)
    except (UnicodeDecodeError, configparser.Error, ValueError) as exc:
        raise ControlError("invalid maintenance config") from exc
    if address.version != 4 or address.is_unspecified or address.is_multicast:
        raise ControlError("maintenance bind_host must be a specific IPv4 address")
    if not 1 <= port <= 65535:
        raise ControlError("maintenance bind_port must be between 1 and 65535")
    return str(address), port


def _systemctl(*arguments: str) -> bool:
    return subprocess.run(
        [SYSTEMCTL, *arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def _unit_active(unit: str) -> bool:
    return _systemctl("is-active", "--quiet", unit)


def _unit_state(unit: str) -> str:
    result = subprocess.run(
        [SYSTEMCTL, "show", unit, "--property=ActiveState", "--value"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return "unknown"
    return result.stdout.strip() or "unknown"


def _probe(host: str, port: int, path: str, *, maintenance: bool) -> bool:
    connection = http.client.HTTPConnection(host, port, timeout=1.0)
    try:
        connection.request("GET", path, headers={"Connection": "close"})
        response = connection.getresponse()
        response.read(4096)
        if response.status != 200:
            return False
        marker = response.getheader("X-Potato-Maintenance")
        return marker == "1" if maintenance else marker != "1"
    except (OSError, http.client.HTTPException):
        return False
    finally:
        connection.close()


def _port_is_free(host: str, port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind((host, port))
        except OSError:
            return False
    return True


def _wait_until(check) -> bool:  # type: ignore[no-untyped-def]
    for attempt in range(WAIT_ATTEMPTS):
        if check():
            return True
        if attempt + 1 < WAIT_ATTEMPTS:
            time.sleep(WAIT_INTERVAL)
    return False


def _interface_healthy(host: str, port: int) -> bool:
    return _unit_active(INTERFACE_UNIT) and _probe(
        host, port, "/health", maintenance=False
    )


def _maintenance_healthy(host: str, port: int) -> bool:
    return _unit_active(MAINTENANCE_UNIT) and _probe(
        host, port, "/_potato/maintenance-health", maintenance=True
    )


def _restore_interface(host: str, port: int) -> bool:
    stopped = _systemctl("stop", MAINTENANCE_UNIT)
    released = _wait_until(lambda: _port_is_free(host, port))
    started = released and _systemctl("start", INTERFACE_UNIT)
    healthy = started and _wait_until(lambda: _interface_healthy(host, port))
    return stopped and released and started and healthy


def _restore_maintenance(host: str, port: int) -> bool:
    stopped = _systemctl("stop", INTERFACE_UNIT)
    released = _wait_until(lambda: _port_is_free(host, port))
    started = released and _systemctl("start", MAINTENANCE_UNIT)
    healthy = started and _wait_until(lambda: _maintenance_healthy(host, port))
    return stopped and released and started and healthy


def enter(host: str, port: int) -> bool:
    if _maintenance_healthy(host, port) and not _unit_active(INTERFACE_UNIT):
        print("maintenance mode is already active")
        return True
    if not _systemctl("stop", INTERFACE_UNIT):
        print("failed to stop Interface; attempting recovery", file=sys.stderr)
        _restore_interface(host, port)
        return False
    if not _wait_until(lambda: _port_is_free(host, port)):
        print("Interface port did not become free; attempting recovery", file=sys.stderr)
        _restore_interface(host, port)
        return False
    if _systemctl("start", MAINTENANCE_UNIT) and _wait_until(
        lambda: _maintenance_healthy(host, port)
    ):
        print(f"maintenance mode active on {host}:{port}")
        return True
    print("maintenance service failed health verification", file=sys.stderr)
    if not _restore_interface(host, port):
        print("critical: Interface recovery also failed", file=sys.stderr)
    return False


def leave(host: str, port: int) -> bool:
    if _interface_healthy(host, port) and not _unit_active(MAINTENANCE_UNIT):
        print("Interface is already active")
        return True
    if not _systemctl("stop", MAINTENANCE_UNIT):
        print("failed to stop maintenance service", file=sys.stderr)
        return False
    if not _wait_until(lambda: _port_is_free(host, port)):
        print("maintenance port did not become free", file=sys.stderr)
        _restore_maintenance(host, port)
        return False
    if _systemctl("start", INTERFACE_UNIT) and _wait_until(
        lambda: _interface_healthy(host, port)
    ):
        print(f"Interface active on {host}:{port}")
        return True
    print("Interface failed health verification; restoring maintenance", file=sys.stderr)
    if not _restore_maintenance(host, port):
        print("critical: maintenance recovery also failed", file=sys.stderr)
    return False


def status(host: str, port: int) -> bool:
    interface_state = _unit_state(INTERFACE_UNIT)
    maintenance_state = _unit_state(MAINTENANCE_UNIT)
    if _probe(host, port, "/_potato/maintenance-health", maintenance=True):
        listener = MAINTENANCE_UNIT
    elif _probe(host, port, "/health", maintenance=False):
        listener = INTERFACE_UNIT
    elif _port_is_free(host, port):
        listener = "none"
    else:
        listener = "unknown"
    print(f"address={host}:{port}")
    print(f"listener={listener}")
    print(f"{INTERFACE_UNIT}={interface_state}")
    print(f"{MAINTENANCE_UNIT}={maintenance_state}")
    return listener in {INTERFACE_UNIT, MAINTENANCE_UNIT}


def _validate_lock_fd(fd: int) -> int:
    lock_info = os.stat(LOCK_PATH, follow_symlinks=False)
    fd_info = os.fstat(fd)
    if (
        not stat.S_ISREG(lock_info.st_mode)
        or lock_info.st_uid != 0
        or lock_info.st_nlink != 1
        or stat.S_IMODE(lock_info.st_mode) != 0o600
    ):
        raise ControlError("unsafe maintenance lock file")
    if (fd_info.st_dev, fd_info.st_ino) != (lock_info.st_dev, lock_info.st_ino):
        raise ControlError("inherited maintenance lock descriptor does not match lock file")
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    return fd


def _acquire_lock() -> int:
    inherited = os.environ.get("POTATO_MAINTENANCE_LOCK_FD", "").strip()
    if inherited:
        try:
            return _validate_lock_fd(int(inherited))
        except (OSError, ValueError) as exc:
            raise ControlError("invalid inherited maintenance lock") from exc
    try:
        LOCK_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        directory_info = os.lstat(LOCK_DIR)
        if (
            not stat.S_ISDIR(directory_info.st_mode)
            or directory_info.st_uid != 0
            or stat.S_IMODE(directory_info.st_mode) != 0o700
        ):
            raise ControlError("unsafe maintenance lock directory")
        fd = os.open(
            LOCK_PATH,
            os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
        )
        os.fchmod(fd, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            os.close(fd)
            raise ControlError("unsafe maintenance lock file")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except BlockingIOError as exc:
        raise ControlError("another maintenance transition or deployment is running") from exc
    except OSError as exc:
        raise ControlError(f"unable to acquire maintenance lock: {exc}") from exc


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("enter", "leave", "status"))
    parser.add_argument("--config", type=Path, default=CONFIG_PATH)
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    if os.geteuid() != 0:
        print("potato-maintenancectl must run as root", file=sys.stderr)
        return 2
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        host, port = _load_address(args.config)
        lock_fd = _acquire_lock()
    except (ControlError, OSError) as exc:
        print(f"maintenance control error: {exc}", file=sys.stderr)
        return 2
    try:
        if args.command == "enter":
            ok = enter(host, port)
        elif args.command == "leave":
            ok = leave(host, port)
        else:
            ok = status(host, port)
    finally:
        if not os.environ.get("POTATO_MAINTENANCE_LOCK_FD", "").strip():
            os.close(lock_fd)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
