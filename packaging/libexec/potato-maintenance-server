#!/usr/bin/python3
"""Minimal same-port maintenance HTTP server for Potato Agent."""

from __future__ import annotations

import argparse
import configparser
import ipaddress
import json
import os
from dataclasses import dataclass
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import stat
import sys
from urllib.parse import urlsplit


DEFAULT_CONFIG = Path("/etc/potato-maintenance.conf")
DEFAULT_ASSET_DIR = Path("/usr/local/share/potato-agent/maintenance")
MAX_CONFIG_BYTES = 16 * 1024
MAX_ASSET_BYTES = 2 * 1024 * 1024
RETRY_AFTER_SECONDS = 30
SECURITY_HEADERS = (
    ("Cache-Control", "no-store"),
    ("Retry-After", str(RETRY_AFTER_SECONDS)),
    (
        "Content-Security-Policy",
        "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; "
        "script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; "
        "form-action 'none'; frame-ancestors 'none'",
    ),
    ("X-Content-Type-Options", "nosniff"),
    ("X-Potato-Maintenance", "1"),
)


@dataclass(frozen=True)
class ServerConfig:
    host: str
    port: int


@dataclass(frozen=True)
class Assets:
    html: bytes
    logo: bytes


def _read_regular_file(path: Path, *, max_bytes: int) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError(f"not a regular file: {path}")
        if info.st_size > max_bytes:
            raise ValueError(f"file exceeds size limit: {path}")
        body = os.read(fd, max_bytes + 1)
    finally:
        os.close(fd)
    if len(body) > max_bytes:
        raise ValueError(f"file exceeds size limit: {path}")
    return body


def parse_config(raw: bytes) -> ServerConfig:
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read_string(raw.decode("ascii"))
        host = parser.get("server", "bind_host").strip()
        port = parser.getint("server", "bind_port")
    except (UnicodeDecodeError, configparser.Error, ValueError) as exc:
        raise ValueError("invalid maintenance config") from exc
    try:
        address = ipaddress.ip_address(host)
    except ValueError as exc:
        raise ValueError("maintenance bind_host must be an IP address") from exc
    if address.version != 4 or address.is_unspecified or address.is_multicast:
        raise ValueError("maintenance bind_host must be a specific IPv4 address")
    if not 1 <= port <= 65535:
        raise ValueError("maintenance bind_port must be between 1 and 65535")
    return ServerConfig(host=str(address), port=port)


def load_config(path: Path) -> ServerConfig:
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        raise ValueError("maintenance config must be a root-owned regular file")
    if stat.S_IMODE(info.st_mode) & 0o022:
        raise ValueError("maintenance config must not be writable by group or other")
    return parse_config(_read_regular_file(path, max_bytes=MAX_CONFIG_BYTES))


def load_assets(asset_dir: Path) -> Assets:
    if asset_dir.is_symlink() or not asset_dir.is_dir():
        raise ValueError("maintenance asset directory must be a real directory")
    return Assets(
        html=_read_regular_file(asset_dir / "index.html", max_bytes=MAX_ASSET_BYTES),
        logo=_read_regular_file(asset_dir / "logo.png", max_bytes=MAX_ASSET_BYTES),
    )


def make_handler(assets: Assets) -> type[BaseHTTPRequestHandler]:
    class MaintenanceHandler(BaseHTTPRequestHandler):
        server_version = "PotatoMaintenance"
        sys_version = ""

        def version_string(self) -> str:
            return self.server_version

        def log_message(self, format: str, *args: object) -> None:
            return

        def send_error(
            self,
            code: int,
            message: str | None = None,
            explain: str | None = None,
        ) -> None:
            self.close_connection = True
            self.request_version = "HTTP/1.0"
            self._json_unavailable()

        def _send(
            self,
            status_code: int,
            content_type: str,
            body: bytes,
            *,
            include_body: bool = True,
        ) -> None:
            self.send_response(status_code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            for name, value in SECURITY_HEADERS:
                self.send_header(name, value)
            self.end_headers()
            if include_body:
                self.wfile.write(body)

        def _page(self, *, include_body: bool = True) -> None:
            self._send(
                503,
                "text/html; charset=utf-8",
                assets.html,
                include_body=include_body,
            )

        def _json_unavailable(self, *, include_body: bool = True) -> None:
            body = json.dumps(
                {"detail": "Potato Agent is temporarily unavailable"},
                separators=(",", ":"),
            ).encode("ascii")
            self._send(
                503,
                "application/json; charset=utf-8",
                body,
                include_body=include_body,
            )

        def do_GET(self) -> None:
            path = urlsplit(self.path).path
            if path == "/_potato/maintenance-health":
                self._send(200, "application/json; charset=utf-8", b'{"status":"ok"}')
            elif path == "/_potato/maintenance-logo.png":
                self._send(200, "image/png", assets.logo)
            elif path == "/api" or path.startswith("/api/"):
                self._json_unavailable()
            else:
                self._page()

        def do_HEAD(self) -> None:
            path = urlsplit(self.path).path
            if path == "/_potato/maintenance-health":
                self._send(
                    200,
                    "application/json; charset=utf-8",
                    b'{"status":"ok"}',
                    include_body=False,
                )
            elif path == "/_potato/maintenance-logo.png":
                self._send(200, "image/png", assets.logo, include_body=False)
            elif path == "/api" or path.startswith("/api/"):
                self._json_unavailable(include_body=False)
            else:
                self._page(include_body=False)

        def _non_readonly(self) -> None:
            self.close_connection = True
            self._json_unavailable()

        def __getattr__(self, name: str):  # type: ignore[no-untyped-def]
            if name.startswith("do_"):
                return self._non_readonly
            raise AttributeError(name)

    return MaintenanceHandler


class MaintenanceHTTPServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def handle_error(self, request: object, client_address: object) -> None:
        return


def build_server(config: ServerConfig, assets: Assets) -> MaintenanceHTTPServer:
    return MaintenanceHTTPServer((config.host, config.port), make_handler(assets))


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    parser.add_argument("--assets", type=Path, default=DEFAULT_ASSET_DIR)
    parser.add_argument("--print-address", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        config = load_config(args.config)
        if args.print_address:
            print(config.host, config.port)
            return 0
        assets = load_assets(args.assets)
        server = build_server(config, assets)
    except (OSError, ValueError) as exc:
        print(f"maintenance server configuration error: {exc}", file=sys.stderr)
        return 2
    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
