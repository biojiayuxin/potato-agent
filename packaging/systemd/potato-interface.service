[Unit]
Description=Potato Agent web interface
Wants=potato-model-proxy.service
After=network.target potato-model-proxy.service
Conflicts=potato-maintenance.service

[Service]
Type=simple
User=potato-interface
Group=potato-interface
WorkingDirectory=/srv/potato_agent
Environment=INTERFACE_ENVIRONMENT=production
Environment=INTERFACE_ALLOW_INSECURE_HTTP=false
Environment=INTERFACE_BIND_HOST=127.0.0.1
Environment=INTERFACE_SESSION_COOKIE_SECURE=true
Environment=INTERFACE_ARCHIVE_RETENTION_DAYS=99999
Environment=INTERFACE_ARCHIVE_STORAGE_RETENTION_DAYS=30
Environment=INTERFACE_PRIVILEGED_HELPER=/usr/local/libexec/potato-agent-privileged-helper
LoadCredential=interface-session-secret:/etc/potato-agent/credentials/interface-session-secret
LoadCredential=resend-api-key:/etc/potato-agent/credentials/resend-api-key
ExecStart=/opt/interface-env/bin/python -m interface.serve --port 3000
Restart=on-failure
LimitCORE=0
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

[Install]
WantedBy=multi-user.target
